#!/usr/bin/env bash

iface="$1"
if [ -z "$iface" ]; then
  iface=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':wifi' | head -n1 | cut -d: -f1)
fi

con=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | grep -E ':(802-11-wireless|wifi)' | head -n1 | cut -d: -f1)
if [ -z "$con" ] && [ -n "$iface" ]; then
  con=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | grep ":$iface$" | head -n1 | cut -d: -f1)
fi

if [ -z "$con" ]; then
  echo "No active Wi-Fi connection found" >&2
  exit 1
fi

password=$(nmcli -s -g 802-11-wireless-security.psk connection show "$con" 2>/dev/null)
if [ -z "$password" ]; then
  password=$(nmcli -s -g 802-11-wireless-security.wep-key0 connection show "$con" 2>/dev/null)
fi

if [ -z "$password" ]; then
  echo "Could not find password for connection $con" >&2
  exit 1
fi

echo "$password"
