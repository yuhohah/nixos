#!/usr/bin/env bash

action="$1"
address="$2"

if [ -z "$action" ] || [ -z "$address" ]; then
  echo "Usage: bluetooth-device <connect|disconnect|pair|forget> <address>" >&2
  exit 1
fi

case "$action" in
  connect)
    bluetoothctl trust "$address" 2>/dev/null || true
    bluetoothctl connect "$address"
    ;;
  disconnect)
    bluetoothctl disconnect "$address"
    ;;
  pair)
    bluetoothctl pairable on 2>/dev/null || true
    bluetoothctl pair "$address"
    bluetoothctl trust "$address" 2>/dev/null || true
    bluetoothctl connect "$address"
    ;;
  forget|remove)
    bluetoothctl disconnect "$address" 2>/dev/null || true
    bluetoothctl untrust "$address" 2>/dev/null || true
    bluetoothctl remove "$address"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 1
    ;;
esac
