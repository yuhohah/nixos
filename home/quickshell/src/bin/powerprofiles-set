#!/usr/bin/env bash

profile="$2"
[ -z "$profile" ] && profile="$1"

if command -v powerprofilesctl >/dev/null 2>&1; then
  powerprofilesctl set "$profile" 2>/dev/null || true
elif command -v tlp >/dev/null 2>&1; then
  if [ "$profile" = "power-saver" ]; then
    tlp bat 2>/dev/null || true
  else
    tlp ac 2>/dev/null || true
  fi
fi
