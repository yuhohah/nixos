{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "clock",
    "layout": {
      "left": [
        {
          "id": "workspaces"
        }
      ],
      "center": [
        {
          "id": "clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "keyboard-layout"
        }
      ],
      "right": [
        {
          "id": "tray"
        },
        {
          "id": "cpu"
        },
        {
          "id": "memory"
        },
        {
          "id": "bluetooth"
        },
        {
          "id": "network"
        },
        {
          "id": "audio"
        }
      ]
    }
  },
  "disabledPlugins": [
    "system-update",
    "agents"
  ],
  "plugins": []
}
